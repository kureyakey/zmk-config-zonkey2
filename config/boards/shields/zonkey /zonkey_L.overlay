#include "zonkey.dtsi"
#include <behaviors/battery_history_request.dtsi>

/ {
    /* Custom behaviors can go here, but avoid redefining 'none' */

    // ----------------------------------------------------
    // zmk-rgbled-widget 用の LED エイリアス設定
    // ----------------------------------------------------
    aliases {
        led-red = &led0;    // Xiao BLE オンボード赤色LED
        led-green = &led1;  // Xiao BLE オンボード緑色LED
        led-blue = &led2;   // Xiao BLE オンボード青色LED
    };
};

&kscan0 {
    col-gpios
        = <&xiao_d 10 GPIO_ACTIVE_HIGH>
        , <&xiao_d 9 GPIO_ACTIVE_HIGH> 
        , <&xiao_d 8 GPIO_ACTIVE_HIGH> 
        , <&xiao_d 7 GPIO_ACTIVE_HIGH> 
        , <&gpio0 10 GPIO_ACTIVE_HIGH>
        , <&gpio0 9 GPIO_ACTIVE_HIGH>
        ;
};

&left_encoder {
    status = "okay";
};
